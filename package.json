{
  "name": "justid",
  "private": true,
  "description": "Dev tooling only (type checks and tests). The site itself has no dependencies and no build step.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "serve": "python3 tools/serve.py 8765",
    "import-template": "node tools/import-template.mjs",
    "render-landing-specimen": "node tools/render-landing-specimen.mjs",
    "bench-detect": "node tools/bench-detect.mjs",
    "make-qr": "node tools/make-qr.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "video:capture": "node video/capture/capture.mjs",
    "video:build": "node video/tools/run.mjs build",
    "video:check": "node video/tools/run.mjs check",
    "video:snapshot": "node video/tools/run.mjs snapshot",
    "video:preview": "node video/tools/run.mjs preview",
    "video:render": "node video/tools/run.mjs render",
    "video:render:all": "node video/tools/run.mjs render-all"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "gsap": "3.13.0",
    "hyperframes": "0.9.84",
    "qrcode": "1.5.4",
    "typescript": "6.0.3",
    "wrangler": "4.158.0"
  }
}
