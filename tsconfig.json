{
  // Type-checks the plain JavaScript (JSDoc annotations). Nothing is compiled or emitted:
  // the browser runs exactly the files in app/, locales/ and templates/.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": ["app/js/**/*.js", "locales/**/*.js", "templates/**/*.js"]
}
